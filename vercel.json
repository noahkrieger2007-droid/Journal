{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "rm -f package-lock.json && npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
