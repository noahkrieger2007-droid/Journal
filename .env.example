# Supabase — create project at https://supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — stored in Supabase Edge Function secrets (not in client)
# Run: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY is NOT needed here — it lives server-side only
